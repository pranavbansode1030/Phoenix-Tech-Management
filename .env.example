# ==============================================================================
# PHOENIX TECH SOLUTIONS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT KEYS (Frontend / Vite App)
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND / SERVICE ROLE KEY (Server-Side / Admin operations only)
# NEVER expose this key in frontend code or commit to public repositories.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. DIRECT DATABASE CONNECTION STRINGS (PostgreSQL)
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# Direct Connection (Port 5432 - for database migrations, schema push, CLI):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Transaction Pooler (Port 6543 - PgBouncer / Supavisor for serverless / edge):
DATABASE_POOL_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler (Port 5432 - for persistent connections):
DATABASE_SESSION_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_NAME="Phoenix Tech Solutions - Internal Finance Management"
APP_URL=http://localhost:3000

